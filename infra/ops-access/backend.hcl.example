# Copy this non-secret file outside the release bundle and replace the bucket.
# The key is deliberately distinct from the baseline and from every workload.
bucket         = "node-operator-tfstate-123456789012-apnortheast2"
key            = "node-operator/ops-access/terraform.tfstate"
region         = "ap-northeast-2"
dynamodb_table = "node-operator-terraform-lock"
encrypt        = true
