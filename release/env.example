# Non-secret defaults/overrides for interactive-hoodi-release.sh.
# Copy to release/env. The single release entrypoint loads this file automatically.
# Leave FENCE_IMAGE empty only if you are prepared to enter it interactively;
# v0.1.20 did not publish a canonical signing-fence digest record.
REGION=ap-northeast-2
DEPLOYMENT_NAME=node-operator
VALIDATOR_SET=hoodi-001
# Leave blank for a new key ceremony. If set, the generated key must match it.
VALIDATOR_PUBLIC_KEY=
WITHDRAWAL_ADDRESS=0x403FF64383B8ddf994D5563550c8040d89F025Ac
# Optional existing validator keystore directory. It must be an absolute path
# outside this repository and contain exactly one keystore-*.json plus one
# deposit_data-*.json. Leave blank to run a new key ceremony.
EXISTING_KEYSTORE_DIR=
# Optional exact private ECR overrides.
WEB3SIGNER_IMAGE=
POSTGRES_IMAGE=
PRYSM_IMAGE=
FENCE_IMAGE=
# Optional digest-pinned bootstrap toolchain/image overrides. Leave blank to
# use the v0.1.20 release approval bindings (or prompt if the mirror is absent).
ARGOCD_BOOTSTRAP_IMAGE=
VAULT_BOOTSTRAP_IMAGE=
CLIENT_CHART_VERSION=
CLIENT_CHART_DIGEST=
# Same-account source Region used for an existing immutable client chart.
CLIENT_CHART_SOURCE_REGION=ap-northeast-2
VAULT_CHART_VERSION=0.31.0
VAULT_CHART_DIGEST=sha256:85cfa6b40396a198a104fbf06c7cccaf75428db7201394f9061c272441bcd0e4
